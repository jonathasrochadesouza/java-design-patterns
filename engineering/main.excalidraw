    {
      "id": "rpj76WM7NSPbQqJB0i2Go",
      "type": "text",
      "x": 1358.5465401074566,
      "y": 773.8521684874445,
      "width": 429.6664149821925,
      "height": 125.81441360632826,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],

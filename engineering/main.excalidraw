    {
      "id": "k2RomAa2ieBRntDTueudX",
      "type": "text",
      "x": 4327.030955528566,
      "y": 774.2597662261601,
      "width": 307.2998046875,
      "height": 25,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",

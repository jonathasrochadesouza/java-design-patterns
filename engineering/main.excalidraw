    {
      "id": "rpj76WM7NSPbQqJB0i2Go",
      "type": "text",
      "x": 1358.5465401074566,
      "y": 773.8521684874445,
      "width": 429.6664149821925,
      "height": 125.81441360632826,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aN",
      "roundness": null,
      "seed": 1204838116,
      "version": 1348,
      "versionNonce": 1648083172,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789478919294,
      "link": null,
      "locked": false,
      "text": "One class have a uniq responsibility, objective and anything more.\n\nOne class needs have a limit scoope.\n\nIf, for example, someone from HR requests a correction to a class, and\nsomeone from Sales makes another request for that same class, it might end\nup doing more than it should.\n\nAnd perhaps it will be necessary to break it down into further responsibilities.",
      "fontSize": 11.183503431673623,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "One class have a uniq responsibility, objective and anything more.\n\nOne class needs have a limit scoope.\n\nIf, for example, someone from HR requests a correction to a class, and someone from Sales makes another request for that same class, it might end up doing more than it should.\n\nAnd perhaps it will be necessary to break it down into further responsibilities.",
      "autoResize": false,
      "lineHeight": 1.25
    },

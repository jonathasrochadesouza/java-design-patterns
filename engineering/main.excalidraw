      "width": 467.8943775504262,
      "height": 97.8556550271442,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aQ",
      "roundness": null,
      "seed": 723032420,
      "version": 1285,
      "versionNonce": 75944028,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789479064999,
      "link": null,
      "locked": false,
      "text": "Think of a Swiss Army knife: it performs many functions at once (which is great for\nus), but that’s not how it works in code. In code, we should acquire each of the\nknife's functions separately, each with its own single responsibility!\n\nIf it has a can opener, for instance, we would have a class dedicated solely to the\ncan opener; if it has a cutting blade, then we would have a separate component just\nfor that blade...",
      "fontSize": 11.183503431673623,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Think of a Swiss Army knife: it performs many functions at once (which is great for us), but that’s not how it works in code. In code, we should acquire each of the knife's functions separately, each with its own single responsibility!\n\nIf it has a can opener, for instance, we would have a class dedicated solely to the can opener; if it has a cutting blade, then we would have a separate component just for that blade...",
      "autoResize": false,
      "lineHeight": 1.25
    },

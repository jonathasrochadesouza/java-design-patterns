      "link": null,
      "locked": false,
      "text": "Liskov substitution principle (LSP)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Liskov substitution principle (LSP)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "-BOZFj2QoEFk_786tggqt",
      "type": "rectangle",
      "x": -765.8587967216245,
      "y": -642.9926656972777,
      "width": 2513.2284396802297,
      "height": 440.9090909090909,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a3",
      "roundness": null,
      "seed": 2046888973,
      "version": 515,

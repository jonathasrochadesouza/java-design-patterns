    {
      "id": "_2OGPO5ib3nIFwFOQZwXQ",
      "type": "text",
      "x": 352.9905357631542,
      "y": -150.7935053761678,
      "width": 309.23980712890625,
      "height": 25,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aA",
      "roundness": null,
      "seed": 722898093,
      "version": 400,
      "versionNonce": 205038765,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789856106396,
      "link": null,
      "locked": false,
      "text": "My understood about it (en-us)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",

    {
      "id": "VFP-dXdRM6plhgnRUNCzf",
      "type": "text",
      "x": -65.30766642515027,
      "y": -65.96147412616756,
      "width": 309.23980712890625,
      "height": 25,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a9",
      "roundness": null,
      "seed": 1848935018,
      "version": 297,
      "versionNonce": 1117263286,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789856077123,
      "link": null,
      "locked": false,
      "text": "My understood about it (en-us)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "My understood about it (en-us)",
      "autoResize": true,

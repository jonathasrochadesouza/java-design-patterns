    {
      "id": "FAyMV23HwLtzb5dxg4csX",
      "type": "text",
      "x": -1004.4327765196449,
      "y": -227.88334947316866,
      "width": 307.2998046875,
      "height": 25,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a5",

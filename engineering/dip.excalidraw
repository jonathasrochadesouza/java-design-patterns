      "text": "Dependency Inversion Principle (DIP)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dependency Inversion Principle (DIP)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "k_nbwxKulTGBoMU75Zk-U",
      "type": "rectangle",
      "x": -1035.1944354467942,
      "y": -720.0825094472777,
      "width": 2513.2284396802297,
      "height": 440.9090909090909,
      "angle": 0,
      "strokeColor": "#1e1e1e",

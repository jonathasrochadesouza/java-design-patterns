      "locked": false
    },
    {
      "id": "VlENRg9hvdOCkYOVMiEEy",
      "type": "text",
      "x": -870.9120854183657,
      "y": 93.74447981818793,
      "width": 933.9984462321926,
      "height": 111.83503431673623,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a3",
      "roundness": null,
      "seed": 1350413231,
      "version": 2883,
      "versionNonce": 1855209281,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789856684178,
      "link": null,
      "locked": false,
      "text": "Classes não devem ser forçadas a depender de métodos que não usam!\n\nEsse princípio evita manter interfaces infladas, com muitos métodos que não precisam ser usados no cliente/classe final ou em todas as classes!\n\nQuando é implementado interfaces infladas, algumas classes são obrigadas a implementar classes que não usam, e muitas das vezes temos um método vazio no meio de uma\nclasse que não faz nada, só porque aquela classe é obrigada a ser implementada!\n\nPor fim, lembre-se: nenhuma classe deve ser obrigada a depender ou implementar métodos que não utilizará!",
      "fontSize": 11.183503431673623,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Classes não devem ser forçadas a depender de métodos que não usam!\n\nEsse princípio evita manter interfaces infladas, com muitos métodos que não precisam ser usados no cliente/classe final ou em todas as classes!\n\nQuando é implementado interfaces infladas, algumas classes são obrigadas a implementar classes que não usam, e muitas das vezes temos um método vazio no meio de uma classe que não faz nada, só porque aquela classe é obrigada a ser implementada!\n\nPor fim, lembre-se: nenhuma classe deve ser obrigada a depender ou implementar métodos que não utilizará!",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {

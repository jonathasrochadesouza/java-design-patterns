      "link": null,
      "locked": false,
      "text": "Interface Segregation Principle (ISP)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Interface Segregation Principle (ISP)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "dxt0mOJFSyPQChcgUy7Mp",
      "type": "rectangle",
      "x": -900.2725604467942,
      "y": -448.9898973318642,
      "width": 2513.2284396802297,
      "height": 440.9090909090909,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a2",
      "roundness": null,
      "seed": 1467823503,
      "version": 540,
      "versionNonce": 239672879,

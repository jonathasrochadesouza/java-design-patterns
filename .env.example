# MCP Servers — LinkedIn + Medium
# Copie este arquivo para .env e preencha os valores.
# O .env NÃO deve ser commitado (está no .gitignore).

# === LinkedIn ===
# 1. Acesse https://www.linkedin.com/developers/
# 2. Crie um App (ou use existente)
# 3. Products → adicione: "Share on LinkedIn" + "Sign In with LinkedIn using OpenID Connect"
# 4. Auth → OAuth 2.0 tools → gere um Access Token (scopes: openid, profile, email, w_member_social)
# 5. Token expira em 60 dias — gere um novo quando parar de funcionar
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# === Medium ===
# 1. Acesse https://medium.com/me/settings/security
# 2. Scroll até "Integration tokens"
# 3. Clique "New integration token"
# 4. Copie o token
MEDIUM_TOKEN=
